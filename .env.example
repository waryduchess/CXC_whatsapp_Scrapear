FILTRO_MODO=todos
# Puerto del panel web local (por defecto 3001).
PANEL_PORT=3001
# Tamaño de página para imágenes convertidas a PDF: A4 o LETTER.
# PDF_PAGINA=A4
# Estos valores son la configuración inicial. Una vez que guardas los filtros
# desde el panel, se usa config/filtros.json (tiene prioridad sobre .env).
# Para whitelist: números o nombres exactos de grupos, separados por comas.
NUMEROS_PERMITIDOS=
NUMEROS_BLOQUEADOS=
# Puedes usar el nombre visible del grupo o su ID terminado en @g.us.
GRUPOS_PERMITIDOS=
GRUPOS_BLOQUEADOS=

# Modos disponibles: todos, whitelist, blacklist, solo_privados, solo_grupos
# FILTRO_MODO=whitelist

# Opcionales: desactivan grupos o chats privados por completo.
# PERMITIR_GRUPOS=true
# PERMITIR_PRIVADOS=true

# Confirmación en WhatsApp: reacciona al mensaje cuando el comprobante se guarda.
# Actívalo o desactívalo con REACCION_ACTIVA.
REACCION_ACTIVA=true
REACCION_EMOJI=🤖
# Retraso base en milisegundos; la espera real va de este valor al doble.
REACCION_RETRASO_MS=1500
# Máximo de reacciones por día (0 desactiva).
REACCION_MAX_DIA=200
# No reaccionar a mensajes con más antigüedad que estos minutos (0 sin límite).
REACCION_MAX_EDAD_MIN=10

# --- Extracción de datos con DeepSeek ---
# Sin esta llave el bot guarda y reacciona igual, pero no analiza comprobantes.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# IA_TIMEOUT_MS=90000
# IA_REINTENTOS=3

# ─── Rutas de almacenamiento ──────────────────────────────────────────────────
# Carpeta donde el bot guarda los comprobantes.
# Si no se define, usa la subcarpeta "comprobantes/" dentro del proyecto.
# Acepta variables de entorno: %USERPROFILE%, %OneDrive%, $HOME, ~ (tilde).
# NO usar raíces de unidad (C:\) ni rutas UNC (\\servidor\carpeta).
#
# Ejemplo Windows:
#   COMPROBANTES_DIR=C:\CXC\comprobantes
#   COMPROBANTES_DIR=%USERPROFILE%\Documents\CXC\comprobantes
# Ejemplo Linux:
#   COMPROBANTES_DIR=/srv/cxc/comprobantes
# COMPROBANTES_DIR=

# Carpeta LOCAL de OneDrive donde se espejará cada comprobante.
# Debe ser la carpeta sincronizada por el cliente de OneDrive Desktop,
# NO una unidad de red ni un enlace UNC.
# Si no se define, el espejo queda desactivado (el bot funciona igual).
#
# Pasos previos en Windows:
#   1. Clic derecho en la carpeta → "Mantener siempre en este dispositivo".
#   2. Desactivar "Archivos a petición" para evitar placeholders (ENOENT/EIO).
#
# Ejemplo Windows (ruta simple):
#   ONEDRIVE_DIR=C:\Users\Erik\OneDrive\Comprobantes
# Ejemplo Windows (ruta con espacios):
#   ONEDRIVE_DIR=C:\Users\Erik\OneDrive - Empresa\Comprobantes
# Ejemplo con variable de entorno:
#   ONEDRIVE_DIR=%OneDrive%\Comprobantes
# ONEDRIVE_DIR=
